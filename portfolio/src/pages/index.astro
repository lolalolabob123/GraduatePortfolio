---
import Layout from '../layouts/Layout.astro'

const projects = [
	{
		title: "TwinTiles Puzzle Game",
		description: "A mobile logic puzzle game built with React Native and Expo. Players must solve grids by adhering to strict layout rules, requiring custom validation algorithms.",
		tech: ["React Native", "Expo", "TypeScript"],
		highlights: [
			"Engineered custom validation algorithms enforcing strict layout rules: no more than two tiles of the same color can sit directly next to each other, including those placed by the player.",
			"Utilized persistent local storage to save game states, levels, and user progress across sessions.",
			"Built a highly responsive, tactile mobile layout optimized for different screen ratios using Expo."
		],
		github: "https://github.com/lolalolabob123/PuzzleGameProject",
		demo: "https://phenomenal-basbousa-07227e.netlify.app/",
    playStore: "https://play.google.com/store/apps/details?id=com.callumcandy.twintiles",
    status: "Published on Google Play",
    image: "/images/twintiles-gameplay.png",
    imageAlt: "TwinTiles mobile puzzle game showing a grid of blue and yellow tiles with gameplay controls",
	},
	{
		title: "Kanban Project Management App",
		description: "A full-stack workflow application inspired by Trello that allows users to create boards, manage tasks, and organize custom workflows.",
		tech: ["React", "TypeScript", "Express", "MongoDB", "Tailwind CSS"],

    highlights: [
      "Implemented drag-and-drop task management using React and TypeScript, allowing users to organise and reorder tasks across columns.",
      "Developed REST API endpoints with Node.js and Express to create, retrieve, update and delete boards, lists and tasks.",
      "Integrated MongoDB for persistent data storage, separating backend functionality into routes, controllers and models."
  ],

		github: "https://github.com/lolalolabob123/TrelloClone",
		demo: "https://taupe-kelpie-921189.netlify.app/",
    image: "/images/kanban-board.png",
    imageAlt: "Kanban project management application with To Do, In Progress and Completed columns, task cards and colour-coded priority labels",
	},
	{
		title: "Natureza Gardening PWA",
		description: "A full-stack progressive web application for plant care, virtual garden management, and seed purchasing built in a collaborative team setting.",
		tech: ["JavaScript", "Express", "MongoDB", "Node.js", "PWA"],
    highlights: [
      "Developed the Node.js and Express backend, implementing REST APIs, MongoDB integration and session-based authentication.",
      "Built interactive shopping and garden-management features, including cart functionality and Service Worker caching.",
      "Collaborated with a multidisciplinary team to integrate design assets into responsive HTML, CSS and JavaScript interfaces."
    ],

		github: "https://github.com/lolalolabob123/Gardening-App",
		demo: "https://gardening-app-f7ee.onrender.com",
    image: "/images/natureza-shop.png",
    imageAlt: "Natureza gardening application displaying plant products, shopping-cart items, quantity controls and a calculated order total",

	}
]
---

<Layout>
	<main class="max-w-4xl mx-auto px-6 py-16 md:py-24 space-y-24">

	<!-- Hero Section -->
	<section class="min-h-[70vh] flex flex-col justify-center space-y-6">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white leading-tight">
      Junior Software Developer building{" "}
      <span class="text-indigo-400">
        web and mobile applications.
      </span>
    </h1>

    <p class="text-lg md:text-xl text-slate-400 max-w-2xl leading-relaxed">
      I'm a BSc (Hons) Creative Computing graduate specialising in React, TypeScript,
      React Native and Node.js. I build responsive web applications, full-stack systems and mobile experiences,
      including TwinTiles, an independently developed puzzle game published on Google Play.
    </p>

	  	<div class="flex flex-wrap gap-4 pt-4">
	  		<a href="#projects" class="px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-500 transition-colors shadow-md cursor-pointer">
			View projects
			</a>
			<a href="https://github.com/lolalolabob123" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-slate-900 border border-slate-800 text-slate-200 font-medium rounded-lg hover:bg-slate-850 hover:border-slate-700 transition-all cursor-pointer">
			Github
			</a>
		</div>
	</section>

	<!-- About Me Section -->
    <section id="about"
      class="grid md:grid-cols-3 gap-8 pt-8 border-t border-slate-900 scroll-mt-24"
    >
      <h2 class="text-2xl font-bold text-white">
        About Me
      </h2>

      <div class="md:col-span-2 space-y-6 text-slate-300 leading-relaxed">

<p class="text-lg text-white font-medium">
  Hi, I'm Callum.
</p>

<p>
  I'm a software developer and BSc (Hons) Creative Computing
  graduate from Bath Spa University, where I achieved a 2:1.
  I enjoy building practical applications that combine
  thoughtful design with reliable functionality.
</p>

<p>
  My experience spans frontend, backend and mobile development,
  primarily using
  <strong class="text-indigo-400">
    React, TypeScript, React Native, Node.js and MongoDB.
  </strong>
  I've developed full-stack applications and independently
  published TwinTiles, an Android puzzle game available
  on Google Play.
</p>

<p>
  I enjoy solving technical problems, learning new technologies
  and improving the usability and maintainability of my projects.
  I'm currently seeking junior software development opportunities
  where I can contribute to a team and continue developing
  my engineering skills.
</p>

</div>

    </section>

	<!-- Technical Skills Section -->
    <section id="skills" class="grid md:grid-cols-3 gap-8 pt-8 border-t border-slate-900 scroll-mt-24">
      <div>
        <h2 class="text-2xl font-bold text-white sticky top-8">Skills & Technologies</h2>
        <p class="text-slate-400 mt-2 text-sm leading-relaxed">
          My technical toolkit focused on modern frontend engineering, clean system architecture, and inclusive user experiences.
        </p>
      </div>
      
      <div class="md:col-span-2 space-y-12">
        <!-- Part 1: Core Competency Cards -->
        <div class="grid sm:grid-cols-2 gap-6">
          
          <div class="p-6 rounded-xl bg-slate-900/40 border border-slate-900 hover:border-slate-800 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-2">Frontend Development</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              Building responsive, accessible interfaces using React,
              TypeScript, HTML and CSS. Experienced with reusable
              components, state management, Tailwind CSS and translating
              UI designs into functional applications.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-slate-900/40 border border-slate-900 hover:border-slate-800 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-2">Backend & APIs</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              Experienced in writing lightweight backend code with Node.js and Express. I design RESTful APIs and integrate secure MongoDB architectures to feed data directly to frontend client applications.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-slate-900/40 border border-slate-900 hover:border-slate-800 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-2">
              Mobile Development
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              Developing cross-platform mobile applications with React Native,
              Expo and TypeScript. Experienced in implementing interactive
              interfaces, persistent application state and publishing Android
              applications to Google Play.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-slate-900/40 border border-slate-900 hover:border-slate-800 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-2">Development Practices</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              Using Git and GitHub for version control, debugging,
              application issues, and organising code into reusable
              components and maintainable structures. Experienced
              in testing functionality and deploying web and mobile
              applications.
            </p>
          </div>

        </div>

        <!-- Part 2: The Tech Stack Pill Grid -->
        <div class="space-y-6 pt-6 border-t border-slate-900/60">
          
          <!-- Languages -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Languages</h4>
            <div class="flex flex-wrap gap-2">
              {['HTML5', 'CSS3', 'JavaScript (ES6+)', 'TypeScript'].map((tech) => (
                <span class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-900/80 border border-slate-800/85 rounded-lg hover-glow transition-all cursor-default">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Frontend Frameworks -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Frontend</h4>
            <div class="flex flex-wrap gap-2">
              {['React', 'Next.js', 'Astro', 'Tailwind CSS', 'Sass'].map((tech) => (
                <span class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-900/80 border border-slate-800/85 rounded-lg hover-glow transition-all cursor-default">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Mobile Development -->
           <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-400">
              Mobile Development
            </h4>

            <div class="flex flex-wrap gap-2">
              {['React Native', 'Expo', 'Android'].map((tech) => (
                <span class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-900/80 border border-slate-800/85 rounded-lg hover-glow transition-all cursor-default">
                  {tech}
                </span>
              ))}
            </div>
           </div>

          <!-- Backend -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Backend</h4>
            <div class="flex flex-wrap gap-2">
              {['Node.js', 'Express', 'MongoDB', 'REST APIs'].map((tech) => (
                <span class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-900/80 border border-slate-800/85 rounded-lg hover-glow transition-all cursor-default">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Dev Tools -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Tools</h4>
            <div class="flex flex-wrap gap-2">
              {['Git', 'GitHub', 'Vite', 'VS Code', 'npm', 'Figma', 'Postman'].map((tech) => (
                <span class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-900/80 border border-slate-800/85 rounded-lg hover-glow transition-all cursor-default">
                  {tech}
                </span>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

	<!-- Project Section Placeholder -->
<!-- Projects Section -->
    <section id="projects" class="pt-8 border-t border-slate-900 space-y-12 scroll-mt-24">
      <div>
        <h2 class="text-2xl font-bold text-white">Featured Projects</h2>
        <p class="text-slate-400 mt-2 text-sm max-w-xl">
          A selection of full-stack and interactive projects I built to solve real problems and explore new technologies.
        </p>
      </div>
      
      <div class="space-y-16">
        {projects.map((project) => (
          <div class="group grid grid-cols-1 md:grid-cols-2 gap-8 p-6 md:p-8 rounded-2xl bg-slate-900/20 border border-slate-900/60 hover:bg-slate-900/40 hover:border-indigo-500/30 transition-all duration-300">
            
            <!-- Left Side: Basic Info & Tech Stack (Takes up 2/5 columns on desktop) -->
            <div class="md:col-span-2 flex flex-col justify-between space-y-6">
              <div class="space-y-3">
                <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors">
                  {project.title}
                </h3>

                {'status' in project && project.status && (
                  <span class="inline-flex items-center gap-2 w-fit rounded-full border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                    {project.status}
                    </span>
                )}

                <p class="text-sm text-slate-400 leading-relaxed">
                  {project.description}
                </p>

                {'image' in project && project.image && (
                  <div class="mt-5 mx-auto w-full max-w-lg rounded-xl border border-slate-800 bg-slate-950/60 p-4">
                    <img
                      src={project.image}
                      alt={project.imageAlt}
                      loading="lazy"
                      decoding="async"
                      class="mx-auto w-auto max-w-full h-auto max-h-72 rounded-lg object-contain"
                    />
                    </div>
                )}

              </div>
              
              <!-- Tech Tags -->
              <div class="flex flex-wrap gap-2 pt-2">
                {project.tech.map((t) => (
                  <span class="px-2.5 py-1 text-xs font-medium text-indigo-300 bg-indigo-950/40 border border-indigo-900/50 rounded-md">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Right Side: Key Highlights & Links (Takes up 3/5 columns on desktop) -->
            <div class="md:col-span-3 flex flex-col justify-between space-y-6">
              <ul class="space-y-3">
                {project.highlights.map((highlight) => (
                  <li class="flex items-start text-sm text-slate-300 leading-relaxed">
                    <span class="text-indigo-500 mr-2.5 select-none mt-1">✦</span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>

              <!-- Project Action Links -->
              
            <div class="flex flex-wrap items-center gap-x-4 gap-y-3 pt-4 text-sm font-semibold border-t border-slate-900/60">


              {'playStore' in project && project.playStore && (
                <a
                  href={project.playStore}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 transition-colors"
                >
                Google Play
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7 17 17 7M7 7h10v10"
                />
                </svg>
                </a>            
              )}

                <a 
                  href={project.github} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex items-center gap-1.5 text-slate-300 hover:text-white transition-colors cursor-pointer"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                  Source Code
                </a>
                
                {project.demo !== "#" && (
                  <a 
                    href={project.demo} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="flex items-center gap-1.5 text-indigo-400 hover:text-indigo-300 transition-colors cursor-pointer"
                  >
                    Live Demo
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- Contact Section -->
     <section
      id="contact"
      class="pt-8 border-t border-slate-900 scroll-mt-24"
    >
  <div class="max-w-2xl space-y-6">
    <div class="space-y-3">
      <h2 class="text-3xl font-bold text-white">
        Let's work together.
      </h2>

      <p class="text-slate-400 leading-relaxed">
        I'm currently looking for junior software development
        opportunities across web, mobile and full-stack development.
        If you'd like to discuss an opportunity or learn more
        about my work, feel free to get in touch.
      </p>
    </div>

<div class="flex flex-wrap items-center gap-4">
  <a
    href="mailto:callum.candy001@gmail.com"
    class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-500 transition-colors"
  >
    callum.candy001@gmail.com
  </a>

  <a
    href="https://www.linkedin.com/in/callum-candy-738767417/"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-slate-800 bg-slate-900 text-slate-200 font-medium hover:bg-slate-800 transition-colors"
  >
    Connect on LinkedIn
  </a>
</div>

    </div></section>

	</main>



<!-- Footer -->
<footer class="border-t border-slate-900">
  <div
    class="max-w-4xl mx-auto px-6 py-8 flex flex-col sm:flex-row
           items-center justify-between gap-4"
  >
    <p class="text-sm text-slate-500">
      © {new Date().getFullYear()} Callum Candy.
      Built with Astro and Tailwind CSS.
    </p>

    <a
      href="#"
      class="text-sm text-slate-400 hover:text-indigo-400 transition-colors"
    >
      Back to top ↑
    </a>
  </div>
</footer>



</Layout>